# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=1553897242350321714
DISCORD_CLIENT_SECRET=your-client-secret

# MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=parrotshelper

# Dashboard
DASHBOARD_SECRET_KEY=put-a-long-random-string-here-32+chars
DASHBOARD_REDIRECT_URI=https://balanced-art-production-ef43.up.railway.app/callback
DASHBOARD_PORT=8080
# Local testing only (never set these on Railway):
# DASHBOARD_ALLOW_INSECURE_LOCAL=1   # lets OAuth work over http://localhost
# DASHBOARD_DEBUG=1                  # Flask debugger when running dashboard/app.py directly
# Public dashboard URL, used for ticket transcript links (optional if DASHBOARD_REDIRECT_URI is set)
DASHBOARD_BASE_URL=https://your-dashboard.up.railway.app

# "Add the bot to your server" link on the dashboard home page (optional; if empty, one is
# built from DISCORD_CLIENT_ID with Administrator permission)
BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=8&scope=bot%20applications.commands

# /admin page login - the page stays OFF unless both are set AND DASHBOARD_SECRET_KEY is a real secret (16+ chars)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Support/community link shown by /botinfo (optional)
SUPPORT_URL=

# Contact email shown on the /privacy and /terms pages (optional - defaults to the owner's email)
CONTACT_EMAIL=xvoidx53@gmail.com

